# 运行环境
APP_ENV=development
APP_DEBUG=false

# 必填：JWT 签名密钥（至少 32 字符）
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-48-char-secret

# 对话模型（DeepSeek 兼容 OpenAI 协议）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
# Moonshot/Kimi 端点可选：连续追问较频繁用 5m，间隔较长可用 1h
LLM_PROMPT_CACHE_TTL=5m

# 视觉模型：图片理解 / 扫描版 PDF OCR
ZHIPU_API_KEY=
VLM_MODEL=glm-4.6v-flash

# 联网搜索（可选，未配置时使用 DuckDuckGo 兜底）
TAVILY_API_KEY=

# PubMed 生物医学检索（NCBI E-utilities，需联网）
# NCBI_EMAIL 必填：你的邮箱，用于 API 身份标识；NCBI_API_KEY 可选：填了可提升限流额度
NCBI_EMAIL=
NCBI_API_KEY=

# 嵌入与精排
# 中文文献推荐 BAAI/bge-base-zh-v1.5；首次切换后必须重建索引
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
EMBEDDING_FALLBACK_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
# 下载 bge-reranker-v2-m3 后可切换为 BAAI/bge-reranker-v2-m3
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
HF_HUB_OFFLINE=1

# 检索参数
RETRIEVE_CANDIDATES=20
RETRIEVE_TOP_K=4
# 精排阈值：ms-marco 输出的是原始 logit，默认 -10 基本不过滤；
# 换成 bge-reranker 后可改为 0.05 左右做相关性门控
RERANK_MIN_SCORE=-10.0
HYBRID_VECTOR_WEIGHT=0.5
BM25_MAX_DOCS=20000
# LangGraph 单轮最大步数；规划/执行/反思多阶段任务需要更多步数
AGENT_RECURSION_LIMIT=40

# 开局路由：决定本轮走“多步计划(planner)”还是“直接作答(chatbot)”
# auto=规则打分，模糊带才调 LLM 判定（推荐）；rules=纯规则不调 LLM；
# llm=模糊带判定必调 LLM；always_planner / always_chatbot=强制某一侧（调试用）
ROUTER_MODE=auto
ROUTER_LLM_ENABLED=true
# 打分带宽：>= PLAN 走 planner，<= CHATBOT 走 chatbot，中间为模糊带（交给 LLM）
ROUTER_SCORE_PLAN=3
ROUTER_SCORE_CHATBOT=1
# 同一个问题重复提问时复用路由判定结果的秒数（0 表示不缓存）
ROUTER_CACHE_TTL=3600
# 是否把“本轮判定为多步研究/直接作答 + 依据”作为状态提示推给前端
ROUTER_EXPLAIN=true
# 单次工具调用超时（秒），异步类 MCP 工具生效
TOOL_TIMEOUT_SECONDS=45

# 执行层数据丰富化：命中 PMID 但没有摘要时，自动回查 fetch_article_details 补全
# 0 表示关闭；单个工具调用最多补几篇（默认 2）
ENRICH_ABSTRACT_LIMIT=2
# 补全 + 表格转换后的单条工具结果上限（字符），超出截断，防止撑爆 prompt
ENRICH_MAX_CHARS=1600
# 最终答案风格：true=数据优先，并确定性剔除免责声明/学术套话；false=保留原文
ANSWER_CONCISE=true
# 单轮最多允许几次“模型→工具”往返；到上限后不再绑定工具，强制基于已有证据作答
MAX_TOOL_ROUNDS=4

# 上传与抓取限制
MAX_UPLOAD_MB=30
MAX_IMAGE_MB=10
MAX_PDF_MB=50
FETCH_MAX_MB=2
OCR_MAX_PAGES=20

# 可选：抓取域名白名单（逗号分隔，配置后跳过 DNS 公网校验）
# FETCH_ALLOWED_HOSTS=arxiv.org,export.arxiv.org

# 可选：把数据 / 模型缓存移出 C 盘
# DATA_DIR=E:/my-agent-program/data
# KNOWLEDGE_DIR=E:/my-agent-program/knowledge
# MODEL_CACHE_DIR=E:/my-agent-program/.cache/huggingface
